# 首版应用在本机运行，数据库与缓存使用团队专用实例。
# 将占位值换为实际值，并通过部署环境注入。Go 不会自动加载此文件。
PARTNERLEDGER_HTTP_ADDR=127.0.0.1:8080
PARTNERLEDGER_MYSQL_DSN=goapp:REPLACE_ME@tcp(mysql.example.invalid:3307)/goapp?parseTime=true
PARTNERLEDGER_REDIS_ADDR=redis.example.invalid:6380
PARTNERLEDGER_REDIS_PASSWORD=REPLACE_ME
DEEPSEEK_API_KEY=
PARTNERLEDGER_DEEPSEEK_ENDPOINT=
# 支持填写单个模型名，或用英文逗号分隔多个模型组成额度耗尽自动轮换池
PARTNERLEDGER_DEEPSEEK_MODEL=deepseek-flash
